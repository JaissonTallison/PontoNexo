{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "buildCommand": "pnpm --filter @pontonexo/web... build",
    "watchPatterns": [
      "/apps/web/**",
      "/packages/shared/**",
      "/pnpm-lock.yaml"
    ]
  },
  "deploy": {
    "startCommand": "pnpm --filter @pontonexo/web start",
    "healthcheckPath": "/entrar",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
