{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "buildCommand": "pnpm --filter @pontonexo/api... build",
    "watchPatterns": [
      "/apps/api/**",
      "/packages/shared/**",
      "/pnpm-lock.yaml"
    ]
  },
  "deploy": {
    "startCommand": "pnpm --filter @pontonexo/api start:prod",
    "healthcheckPath": "/api/health",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
