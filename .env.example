# Copie para .env e ajuste. Nunca versione o .env.
# Gere as chaves com: pnpm chaves:gerar  (grava RECEIPT_SIGNING_KEY e APP_ENCRYPTION_KEY no .env)

NODE_ENV=development
TZ=UTC

# Banco: o dono (migrações/seed) e o papel de aplicação (API, sujeito a RLS)
DATABASE_OWNER_URL=postgres://pontonexo:pontonexo_dev@localhost:5572/pontonexo
DATABASE_URL=postgres://pontonexo_app:pontonexo_app_dev@localhost:5572/pontonexo
TEST_DATABASE_OWNER_URL=postgres://pontonexo:pontonexo_dev@localhost:5572/pontonexo_test
TEST_DATABASE_URL=postgres://pontonexo_app:pontonexo_app_dev@localhost:5572/pontonexo_test

# API
API_PORT=5570
WEB_ORIGIN=http://localhost:5571
SESSION_TTL_HOURS=12
COOKIE_SECURE=false

# Chaves (base64). Assinatura dos comprovantes (Ed25519, PKCS8 DER) e cifra de segredos de integração (32 bytes)
RECEIPT_SIGNING_KEY=
RECEIPT_KEY_ID=dev-1
APP_ENCRYPTION_KEY=

# Monitor de hora (SNTP). Lista separada por vírgula.
NTP_SERVERS=a.ntp.br,b.ntp.br,c.ntp.br
NTP_MAX_OFFSET_MS=2000
NTP_CHECK_INTERVAL_MINUTES=10
NTP_ENABLED=true

# E-mail (Mailpit em desenvolvimento)
SMTP_HOST=localhost
SMTP_PORT=5575
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="PontoNexo <nao-responda@pontonexo.local>"

# Web
API_INTERNAL_URL=http://localhost:5570

# Backup (scripts/backup.sh)
BACKUP_DIR=./backups
BACKUP_PASSPHRASE=
